{
	"$schema": "./web/node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!web/static/**",
			"!web/build/**",
			"!web/dist/**",
			"!web/.svelte-kit/**",
			"!web/cwv-reports/**",
			"!web/audit/**",
			"!**/*.yaml",
			"!**/*.yml"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true,
			"selfCloseVoidElements": "always"
		}
	},
	"markdown": {
		"formatter": {
			"proseWrap": "preserve",
			"indentStyle": "space",
			"indentWidth": 2
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
